spring.application.name=commerce-api

# MySQL数据库地址
spring.datasource.url=jdbc:mysql://localhost:3306/qixuan_ai

#数据库用户名
spring.datasource.username=qixuan_app

#数据库密码：
spring.datasource.password=CHANGE_ME


spring.flyway.enabled=true
spring.flyway.locations=classpath:db/migration
spring.flyway.encoding=UTF-8
spring.flyway.baseline-on-migrate=false
spring.flyway.validate-on-migrate=true

# ===== 认证 =====
# 密钥必须自己生成，且绝不能提交到仓库（生产用环境变量覆盖）
app.auth.secret=CHANGE_ME_TO_A_RANDOM_64_CHARS
# token 有效期：7 天
app.auth.ttl-seconds=604800

# ===== Redis =====
spring.data.redis.host=localhost
spring.data.redis.port=6379
spring.data.redis.timeout=2s
spring.data.redis.connect-timeout=2s

# ===== Kafka（秒杀订单队列）=====
# 本地用 docker run 起单节点即可，Topic 需要预先创建：
#   kafka-topics.sh --create --topic seckill-order --partitions 3 --replication-factor 1
spring.kafka.bootstrap-servers=localhost:9092

spring.kafka.producer.key-serializer=org.apache.kafka.common.serialization.StringSerializer
spring.kafka.producer.value-serializer=org.springframework.kafka.support.serializer.JsonSerializer
# send() 获取元数据阶段的阻塞上限，默认 60 秒。
# 不改这个值，broker 不可达时每个请求会卡 60 秒，把 Tomcat 线程池打满。
spring.kafka.producer.properties.max.block.ms=3000

spring.kafka.consumer.group-id=seckill-order-group
spring.kafka.consumer.key-deserializer=org.apache.kafka.common.serialization.StringDeserializer
spring.kafka.consumer.value-deserializer=org.springframework.kafka.support.serializer.JsonDeserializer
spring.kafka.consumer.properties.spring.json.trusted.packages=com.qixuan.commerce.entity
spring.kafka.consumer.properties.spring.json.value.default.type=com.qixuan.commerce.entity.SeckillOrder
spring.kafka.consumer.auto-offset-reset=earliest

# 批量消费 + 手动 ack：业务成功才提交 offset，失败重投
spring.kafka.listener.type=batch
spring.kafka.listener.ack-mode=manual_immediate
spring.kafka.consumer.max-poll-records=200


# ===== AI（Agent 层）=====
# 密钥从环境变量注入，不要写在这里
ai.api-key=${DASHSCOPE_API_KEY}
ai.base-url=https://dashscope.aliyuncs.com/compatible-mode/v1
ai.model=qwen-plus
